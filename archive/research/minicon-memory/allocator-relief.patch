+// Temporary research hook; never retained in production.
+#[cfg(target_os = "macos")]
+fn research_allocator_relief(now: Instant) {
+    static START: std::sync::OnceLock<Option<Instant>> = std::sync::OnceLock::new();
+    static DONE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+    let Some(start) = *START.get_or_init(|| std::env::var_os("MINICON_RESEARCH_TRIM").map(|_| now)) else { return; };
+    if now.duration_since(start) < std::time::Duration::from_secs(3) { return; }
+    if DONE.swap(true, std::sync::atomic::Ordering::Relaxed) { return; }
+    unsafe extern "C" { fn malloc_zone_pressure_relief(zone: *mut std::ffi::c_void, goal: usize) -> usize; }
+    let before = Instant::now();
+    // Public Darwin allocator API: null examines all zones; zero requests
+    // best-effort maximal relief, with no user allocation pointers supplied.
+    let released = unsafe { malloc_zone_pressure_relief(std::ptr::null_mut(), 0) };
+    eprintln!("RESEARCH_TRIM released={} elapsed_us={}", released, before.elapsed().as_micros());
+}
