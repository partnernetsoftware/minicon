// suite.bxs - bx's own test suite, written in bx.
//
// This is the self-iteration loop: every case below spawns the compiled
// binary and compares real output. If bx cannot run this file, bx is not
// usable as the tool it claims to be.

// Suite can be pointed at any bx build: the native binary by default, or a
// packed minicon-bx.com to prove the trampoline path end to end.
let BX = env("BX_BIN", __dir__ + "/../target/release/bx.exe")
let casesOk = 0
let casesFail = 0
let failures = []

fn run(argv) {
  return exec([BX] + argv)
}

/** A case that must exit 0 with exactly this stdout (surrounding blank lines trimmed). */
fn check(name, expected, argv) {
  let r = run(argv)
  let got = r.out.trim()
  if (r.code == 0 && got == expected) {
    casesOk += 1
    return
  }
  casesFail += 1
  let suffix = ""
  if (r.err.trim() != "") {
    suffix = "\n    stderr:   " + r.err.trim()
  }
  failures.push(
    name + "\n    expected: " + json(expected) + "\n    got:      " + json(got) + " (exit " + r.code + ")" + suffix
  )
}

/** A case that must fail with this exit code and this text in stderr. */
fn checkFail(name, needle, code, argv) {
  let r = run(argv)
  if (r.code == code && r.err.contains(needle)) {
    casesOk += 1
    return
  }
  casesFail += 1
  failures.push(
    name + "\n    expected exit " + code + " with " + json(needle) +
    "\n    got exit " + r.code + " stderr " + json(r.err.trim()) + " stdout " + json(r.out.trim())
  )
}

fn checkTrue(name, argv) {
  check(name, "true", argv)
}

/** A case that must exit 0 and print text containing this needle. */
fn checkContains(name, needle, argv) {
  let r = run(argv)
  if (r.code == 0 && r.out.contains(needle)) {
    casesOk += 1
    return
  }
  casesFail += 1
  failures.push(
    name + "\n    expected output containing " + json(needle) +
    "\n    got exit " + r.code + " stdout " + json(r.out.trim())
  )
}

// ---------------------------------------------------------------------------
// language
// ---------------------------------------------------------------------------

print("language")
check("arithmetic", "7", ["eval", "1 + 2 * 3"])
check("precedence", "11", ["eval", "2 + 3 * 4 - 6 / 2"])
check("unary and parens", "5", ["eval", "-(3 - 8)"])
check("string methods", "A-B-C", ["eval", '"a,b,c".split(",").join("-").upper()'])
check("string concat", "n=42", ["eval", 'let n = 42; "n=" + n'])
check("json shape", '{"a":1,"b":[true,null]}', ["eval", "json({b:[true, null], a:1})"])
check("json parse", "9", ["eval", 'parse("{\\"x\\":9}").x'])
check("compound assign", "3", ["eval", "let o = {a:1}; o.a += 2; o.a"])
check("array negative index", "3", ["eval", "let a = [1,2,3]; a[-1]"])
check("method sugar", "4", ["eval", 'let a = [2,3]; a.len() + a[0]'])
check("truthiness", '[0,"yes"]', ["eval", 'json([0 && 1, "" || "yes"])'])
check("recursion", "55", ["eval", "fn fib(n) { if (n < 2) { return n } return fib(n-1) + fib(n-2) } fib(10)"])
check("globals visible in fn", "10", ["eval", "let g = 4; fn f(x) { return x + g } f(6)"])
check("higher order", "[0,4,16]", ["eval", "map(filter(range(6), fn(x) { return x % 2 == 0 }), fn(x) { return x * x })"])
check("sort comparator", "[5,3,1]", ["eval", "let a = [1,5,3]; sort(a, fn(x, y) { return y - x }); a"])
check("type names", '["int","str","array","object","fn","null"]', ["eval", 'json([type(1), type("s"), type([]), type({}), type(print), type(null)])'])
check("len", "3", ["eval", 'len({"a":1,"b":2,"c":3})'])
// conditional expression and string interpolation
check("ternary", "yes", ["eval", '1 ? "yes" : "no"'])
check("ternary false branch", "2", ["eval", "0 ? 1 : 2"])
check("ternary nested is right-associative", "3", ["eval", "0 ? 1 : 0 ? 2 : 3"])
check("ternary binds looser than ||", "t", ["eval", '0 || 1 ? "t" : "f"'])
check("interpolation", "n=42", ["eval", 'let n = 42; "n=\${n}"'])
check("interpolation expression", "a3b", ["eval", '"a\${1 + 2}b"'])
check("interpolation method", "hello X", ["eval", 'let s = "x".upper(); "hello \${s}"'])
checkFail("interpolation unterminated", "unterminated string interpolation", 1, ["eval", '"open \${1"'])
checkFail("interpolation empty", "empty string interpolation", 1, ["eval", '"empty \${}"'])

// CLI surface agents rely on
checkContains("--version flag", "bx 0.", ["--version"])
checkContains("--help flag", "usage", ["--help"])
let stdinRun = exec([BX, "eval", "-"], {stdin: "1 + 2"})
if (stdinRun.code == 0 && stdinRun.out.trim() == "3") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("eval reads stdin\n    code=" + stdinRun.code + " stdout=" + json(stdinRun.out.trim()) + " stderr=" + json(stdinRun.err.trim()))
}
check("argv keeps spaces and unicode", '["a b","ü"]', ["run", __dir__ + "/cases/argv.bxs", "a b", "ü"])

check("closure captures a local for a callback", "[10,20,30]", ["eval", "fn scale(base) { return map([1,2,3], fn(x) { return x * base }) } scale(10)"])
check("closure captures parameter and local", "6", ["eval", "fn f(a) { let b = 2; return fn(c) { return a + b + c } } f(1)(3)"])
check("closure sees later updates", "9", ["eval", "fn f() { let n = 1; let g = fn() { return n }; n = 9; return g() } f()"])
check("closures share mutable state", "3", ["eval", "fn make() { let n = 0; return fn() { n = n + 1; return n } } let c = make(); c(); c(); c()"])
check("two closures share one binding", "2", ["eval", "fn make() { let n = 0; return [fn() { n = n + 1; return n }, fn() { return n }] } let p = make(); p[0](); p[0](); p[1]()"])
check("a closure can update a parameter", "2", ["eval", "fn f(x) { let g = fn() { x = x + 1; return x }; g(); return x } f(1)"])
check("loop closures keep their iteration", "[10,21]", ["eval", "fn f() { let fs = []; for i, x in [10, 20] { push(fs, fn() { return x + i }) }; return map(fs, fn(g) { return g() }) } f()"])
check("closure reads two levels up", "5", ["eval", "fn outer() { let n = 5; return fn() { return fn() { return n } } } outer()()()"])
check("closure writes two levels up", "11", ["eval", "fn outer() { let n = 1; let mid = fn() { return fn() { n = n + 10; return n } }; let c = mid(); c(); return n } outer()"])
check("closure reads three levels up", "7", ["eval", "fn a() { let n = 7; return fn() { return fn() { return fn() { return n } } } } a()()()()"])
check("closure writes three levels up", "6", ["eval", "fn a() { let n = 1; return fn() { return fn() { return fn() { n = n + 5; return n } } } } a()()()()"])
check("grandchild capture boxes a local the parent ignores", "9", ["eval", "fn a() { let n = 9; return fn() { return fn() { let q = fn() { return n }; return q() } } } a()()()"])

// iteration: arrays, strings and objects share one protocol
check("iterate object keys", "ab", ["eval", 'let o = {b:2, a:1}; let s = ""; for k in o { s += k } s'])
check("iterate string chars", "a.b.c.", ["eval", 'let s = ""; for c in "abc" { s += c + "." } s'])
check("iterate object values", "1,2", ["eval", 'let o = {a:1, b:2}; join(map(keys(o), fn(k) { return str(o[k]) }), ",")'])

// key/value iteration: objects give key/value, arrays and strings give index/value
check("iterate pairs over an object", "a=1 b=2", ["eval", 'let s = ""; for k, v in {a:1, b:2} { s += k + "=" + v + " " }; s.trim()'])
check("iterate pairs over an array", "0:10 1:20", ["eval", 'let s = ""; for i, x in [10, 20] { s += str(i) + ":" + str(x) + " " }; s.trim()'])
check("iterate pairs over a string", "0a1b", ["eval", 'let s = ""; for i, c in "ab" { s += str(i) + c }; s'])
check("pair iteration inside a function", "3", ["eval", "fn total(o) { let t = 0; for k, v in o { t += v }; return t } total({a:1, b:2})"])
check("loop leaves no residue on the stack", "", ["eval", "for k, v in {a:1} { }"])

// error capture: a failing expression becomes a value, not an exit
check("attempt ok=false", "false", ["eval", "attempt(fn() { return 1 / 0 }).ok"])
check("attempt value", "42", ["eval", "attempt(fn() { return 6 * 7 }).value"])
checkTrue("attempt error text", ["eval", 'attempt(fn() { return 1 / 0 }).error.contains("division by zero")'])

// diagnostics: an error names the failing function and keeps one location
let namedErr = exec([BX, "eval", "fn inner() { return missing } inner()"])
if (namedErr.code == 1 && namedErr.err.contains("in inner()")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("errors name the failing function\n    stderr=" + json(namedErr.err.trim()))
}
let closureErr = exec([BX, "eval", "fn make() { return fn() { return missing } } make()()"])
if (closureErr.code == 1 && closureErr.err.contains("in <lambda>()") && !closureErr.err.contains("<eval>(1): <eval>")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("closure errors are not double-prefixed\n    stderr=" + json(closureErr.err.trim()))
}
check("attempt keeps script alive", "still here", ["eval", 'let r = attempt(fn() { return [][3].x }); if (!r.ok) { print("still here") }'])

// ---------------------------------------------------------------------------
// processes
// ---------------------------------------------------------------------------

print("processes")
// The suite runs on the CI pack host too (macos-15), so process cases use a
// shell each host actually has: cmd on Windows, sh elsewhere.
let WIN = env("OS") == "Windows_NT"
let SH = WIN ? ["cmd", "/C"] : ["sh", "-c"]
let EXIT3 = WIN ? "cmd /C exit 3" : "sh -c 'exit 3'"
let SLEEP = WIN ? "ping -n 4 127.0.0.1 > nul" : "sleep 3"
check("exec exit code", "3", ["eval", 'exec("' + EXIT3 + '").code'])
check("exec stdout", "hi", ["eval", 'exec([' + json(SH[0]) + ',' + json(SH[1]) + ',"echo hi"]).out.trim()'])
check("exec stderr", "boom", ["eval", 'exec([' + json(SH[0]) + ',' + json(SH[1]) + ',"echo boom 1>&2"]).err.trim()'])
check("exec argv", "a b", ["eval", 'exec([' + json(SH[0]) + ',' + json(SH[1]) + ',"echo a b"]).out.trim()'])
check("exec timeout", "true", ["eval", 'exec([' + json(SH[0]) + ',' + json(SH[1]) + ',' + json(SLEEP) + '], {timeout: 50}).timeout'])
check("sh", "shell", ["eval", 'sh("echo shell").out.trim()'])
checkTrue("which finds shell", ["eval", 'which(' + json(WIN ? "cmd" : "sh") + ') != null'])
checkTrue("cwd is a string", ["eval", 'type(cwd()) == "str"'])
checkTrue("env read", ["eval", "len(env()) > 0"])

// ---------------------------------------------------------------------------
// programs
// ---------------------------------------------------------------------------

print("programs")
let loops = "sum 10\nkept [0,2,4]\nwhile 3\nobject {\"a\":1,\"b\":2,\"c\":3} len 3\nnested 5"
check("loops.bxs", loops, ["run", __dir__ + "/cases/loops.bxs"])

let data = "items 3\nnames alpha,beta,gamma\ngood [\"beta\",\"gamma\"]\ntotal 17\nsorted [[9,\"beta\"],[5,\"gamma\"],[3,\"alpha\"]]"
check("data.bxs", data, ["run", __dir__ + "/cases/data.bxs"])

check("use include", "hi agent\n[\"negative\",\"zero\",\"positive\"]", ["run", __dir__ + "/../examples/use-lib.bxs"])
check("argv", '["one","two"]', ["run", __dir__ + "/cases/argv.bxs", "one", "two"])
check("hello example", "hello from bx\n7\n{\"bytes\":2,\"fast\":true}", ["run", __dir__ + "/../examples/hello.bxs"])

// ---------------------------------------------------------------------------
// bytecode
// ---------------------------------------------------------------------------

print("bytecode")
let artDir = __dir__ + "/../target/bx-tests"
// `bx check` compiles without executing, and reports where bad source fails
let checkDir = artDir + "/check"
mkdir(checkDir)
write(checkDir + "/run-me.bxs", 'print("EXECUTED")\n')
let checked = exec([BX, "check", checkDir + "/run-me.bxs"])
if (checked.code == 0 && checked.out.contains("ok ") && !checked.out.contains("EXECUTED")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("check compiles without running\n    code=" + checked.code + " stdout=" + json(checked.out.trim()) + " stderr=" + json(checked.err.trim()))
}
write(checkDir + "/broken.bxs", 'fn f( {\n')
let broken = exec([BX, "check", checkDir + "/broken.bxs"])
if (broken.code == 1 && broken.err.contains("line")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("check reports broken source\n    code=" + broken.code + " stderr=" + json(broken.err.trim()))
}
let missingCheck = exec([BX, "check", checkDir + "/nope.bxs"])
if (missingCheck.code == 1) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("check fails on a missing file\n    code=" + missingCheck.code)

}
// execution budgets: step limit and wall-clock timeout stop runaway scripts
write(artDir + "/spin.bxs", 'while (true) { }\n')
let capped = exec([BX, "run", "--max-steps", "200000", artDir + "/spin.bxs"])
if (capped.code == 1 && capped.err.contains("step limit")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("--max-steps stops a runaway script\n    code=" + capped.code + " stderr=" + json(capped.err.trim()))
}
let timed = exec([BX, "run", "--timeout", "120", artDir + "/spin.bxs"])
if (timed.code == 1 && timed.err.contains("timeout")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("--timeout stops a runaway script\n    code=" + timed.code + " stderr=" + json(timed.err.trim()))
}
check("flags after the script stay in argv", '["--max-steps","5"]', ["run", __dir__ + "/cases/argv.bxs", "--max-steps", "5"])

// `read("-")` drains stdin, so a script can be a pipe filter
let piped = exec([BX, "eval", 'read("-")'], {stdin: "abc"})
if (piped.code == 0 && piped.out.trim() == "abc") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("read drains stdin\n    out=" + json(piped.out) + " err=" + json(piped.err.trim()))
}
write(artDir + "/filter.bxs", 'print(read("-").trim().upper())\n')
let filtered = exec([BX, "run", artDir + "/filter.bxs"], {stdin: "hello pipe"})
if (filtered.code == 0 && filtered.out.trim() == "HELLO PIPE") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("a script filters stdin\n    out=" + json(filtered.out) + " err=" + json(filtered.err.trim()))
}
let drained = exec([BX, "eval", 'read("-") + "|" + read("-")'], {stdin: "x"})
if (drained.code == 0 && drained.out.trim() == "x|") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("a drained stdin reads as empty\n    out=" + json(drained.out))
}
// include diagnostics and machine-readable check output
write(artDir + "/jgood.bxs", 'print(1)\n')
let jgood = exec([BX, "check", "--json", artDir + "/jgood.bxs"])
let jgoodObj = parse(jgood.out)
if (jgood.code == 0 && jgoodObj.ok == true && jgoodObj.chunks >= 1) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("check --json reports success\n    out=" + json(jgood.out.trim()) + " code=" + jgood.code)
}
write(artDir + "/jbad.bxs", 'fn f( {\n')
let jbad = exec([BX, "check", "--json", artDir + "/jbad.bxs"])
let jbadObj = parse(jbad.out)
if (jbad.code == 1 && jbadObj.ok == false && len(jbadObj.error) > 0) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("check --json reports failure\n    out=" + json(jbad.out.trim()))
}
write(artDir + "/inc-lib.bxs", 'break\n')
write(artDir + "/inc-main.bxs", 'use "inc-lib.bxs"\n')
let incErr = exec([BX, "check", artDir + "/inc-main.bxs"])
if (incErr.code == 1 && incErr.err.contains("inc-lib.bxs")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("include errors name the include file\n    stderr=" + json(incErr.err.trim()))
}
write(artDir + "/nested-c.bxs", 'break\n')
write(artDir + "/nested-b.bxs", 'use "nested-c.bxs"\n')
write(artDir + "/nested-a.bxs", 'use "nested-b.bxs"\n')
let nestedErr = exec([BX, "check", artDir + "/nested-a.bxs"])
if (nestedErr.code == 1 && nestedErr.err.contains("nested-c.bxs") && len(nestedErr.err.split(".bxs")) == 2) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("nested includes do not stack prefixes\n    stderr=" + json(nestedErr.err.trim()))
}
write(artDir + "/inc-missing.bxs", 'use "no-such-file.bxs"\n')
let missingInc = exec([BX, "check", artDir + "/inc-missing.bxs"])
if (missingInc.code == 1 && missingInc.err.contains("inc-missing.bxs")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("missing include names the referencing file\n    stderr=" + json(missingInc.err.trim()))
}
// runtime errors name the include file that defined the failing function
write(artDir + "/rt-lib.bxs", 'fn boom() {\n  return missing_var\n}\n')
write(artDir + "/rt-main.bxs", 'use "rt-lib.bxs"\nboom()\n')
let rtErr = exec([BX, "run", artDir + "/rt-main.bxs"])
if (rtErr.code == 1 && rtErr.err.contains("in boom()") && rtErr.err.contains("rt-lib.bxs")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("runtime errors name the include file\n    stderr=" + json(rtErr.err.trim()))
}
let rtBuild = exec([BX, "build", artDir + "/rt-main.bxs", "-o", artDir + "/rt-main.bxb"])
let rtBxb = exec([BX, "run", artDir + "/rt-main.bxb"])
if (rtBuild.code == 0 && rtBxb.code == 1 && rtBxb.err.contains("rt-lib.bxs") && rtBxb.err.contains("boom")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("bytecode keeps the defining file\n    build=" + rtBuild.code + " run=" + rtBxb.code + " stderr=" + json(rtBxb.err.trim()))
}
// a leading shebang is ignored, so scripts run directly on Unix
write(artDir + "/shebang.bxs", '#!/usr/bin/env bx\nprint(41 + 1)\n')
check("shebang scripts run", "42", ["run", artDir + "/shebang.bxs"])
write(artDir + "/shebang-line.bxs", '#!/usr/bin/env bx\nlet x = 1\nmissing_after_shebang\n')
let sbErr = exec([BX, "run", artDir + "/shebang-line.bxs"])
if (sbErr.code == 1 && sbErr.err.contains("(3)")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("shebang keeps line numbers\n    stderr=" + json(sbErr.err.trim()))
}
// patch(path, diff): structured edits for self-iteration, atomic on failure
let pTarget = artDir + "/patch-target.txt"
let pRunner = artDir + "/patch-run.bxs"
write(pRunner, 'print(json(patch(argv[0], read(argv[1]))))\n')
write(pTarget, "alpha\nbeta\ngamma\n")
write(artDir + "/patch.diff", "--- a/patch-target.txt\n+++ b/patch-target.txt\n@@ -1,3 +1,4 @@\n alpha\n-beta\n+beta2\n+delta\n gamma\n")
let pOk = exec([BX, "run", pRunner, pTarget, artDir + "/patch.diff"])
if (pOk.code == 0 && read(pTarget) == "alpha\nbeta2\ndelta\ngamma\n") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("patch applies a unified diff\n    out=" + json(pOk.out.trim()) + " file=" + json(read(pTarget)))
}
write(pTarget, "one\ntwo\nthree\n")
write(artDir + "/patch-bad.diff", "--- a/patch-target.txt\n+++ b/patch-target.txt\n@@ -1,2 +1,2 @@\n one\n-TWO\n+two\n")
let pBad = exec([BX, "run", pRunner, pTarget, artDir + "/patch-bad.diff"])
if (pBad.code == 1 && pBad.err.contains("hunk 1") && read(pTarget) == "one\ntwo\nthree\n") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("a rejected hunk leaves the file untouched\n    err=" + json(pBad.err.trim()) + " file=" + json(read(pTarget)))
}
write(pTarget, "line1\nline2\nline3\nline4\nline5\nline6\nline7\nline8\nline9\nline10\n")
write(artDir + "/patch-multi.diff", "--- a/patch-target.txt\n+++ b/patch-target.txt\n@@ -1,3 +1,3 @@\n line1\n-line2\n+LINE2\n line3\n@@ -9,2 +9,3 @@\n line9\n+line9b\n line10\n")
let pMulti = exec([BX, "run", pRunner, pTarget, artDir + "/patch-multi.diff"])
let pMultiText = read(pTarget)
if (pMulti.code == 0 && pMultiText.contains("LINE2") && pMultiText.contains("line9b")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("patch applies multiple hunks\n    out=" + json(pMulti.out.trim()) + " file=" + json(pMultiText))
}
// exec_all runs commands concurrently and keeps the input order
let pairAll = exec_all([[BX, "eval", "1+1"], [BX, "eval", "2+2"]])
if (len(pairAll) == 2 && pairAll[0].out.trim() == "2" && pairAll[1].out.trim() == "4") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("exec_all keeps the input order\n    got=" + json(pairAll))
}
let mixedAll = exec_all([[BX, "eval", "3+3"], ["definitely-not-a-command-xyz"]])
if (mixedAll[0].code == 0 && mixedAll[1].ok == false && len(mixedAll[1].err) > 0) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("exec_all isolates a failed command\n    got=" + json([mixedAll[0].code, mixedAll[1].ok]))
}
let allStart = now()
let slowAll = exec_all([[BX, "eval", "sleep(400); 1"], [BX, "eval", "sleep(400); 2"]])
let allWall = now() - allStart
if (slowAll[0].code == 0 && slowAll[1].code == 0 && allWall < 700) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("exec_all runs concurrently\n    wall=" + allWall + "ms codes=" + json([slowAll[0].code, slowAll[1].code]))
}
// exec can stream a command's output straight to a file
let outFile = artDir + "/exec-out.txt"
let errFile = artDir + "/exec-err.txt"
let redirected = exec([BX, "eval", "print(41 + 1)"], {stdout: outFile})
if (redirected.code == 0 && redirected.out == "" && read(outFile).trim() == "42") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("exec redirects stdout to a file\n    out=" + json(redirected.out) + " file=" + json(read(outFile)))
}
let redirectedErr = exec([BX, "eval", "eprint(\"boom\")"], {stderr: errFile})
if (redirectedErr.code == 0 && redirectedErr.err == "" && read(errFile).trim() == "boom") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("exec redirects stderr to a file\n    err=" + json(redirectedErr.err) + " file=" + json(read(errFile)))
}
// spawn: background processes with incremental output, stdin and kill
write(artDir + "/spawn-wait.bxs", 'let h = spawn([argv[0], "eval", "print(1 + 1)"])\nprint(json(spawn_wait(h.id)))\n')
let sw = exec([BX, "run", artDir + "/spawn-wait.bxs", BX])
let swr = parse(sw.out)
if (sw.code == 0 && swr.code == 0 && swr.out.trim() == "2") {
  casesOk += 1
} else {
  casesFail += 1
