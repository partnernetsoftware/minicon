write(artDir + "/wasm-hofstr.bxs", 'for v in filter(["a", "bb", "ccc"], fn(s) { return s.len() > 1 }) { print(v) }\nfor v in map(["a", "b"], fn(s) { return s + "!" }) { print(v) }\nfor v in map(["aa", "b"], fn(s) { return s.len() }) { print(v) }\nlet w = ["x", "yy"]\nw = map(w, fn(s) { return "[" + s + "]" })\nprint(join(w, ","))\n')
let wasmHofStr = exec([BX, "build", "--wasm", artDir + "/wasm-hofstr.bxs", "-o", artDir + "/wasm-hofstr.wasm"])
let wasmHofStrRun = exec([BX, "run", artDir + "/wasm-hofstr.wasm"])
let wasmHofStrVm = exec([BX, "run", artDir + "/wasm-hofstr.bxs"])
if (wasmHofStr.code == 0 && wasmHofStrRun.out == wasmHofStrVm.out && wasmHofStrRun.out.trim() == "bb\nccc\na!\nb!\n2\n1\n[x],[yy]") {
