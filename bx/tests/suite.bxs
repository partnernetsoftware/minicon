write(artDir + "/wasm-arrkind.bxs", 'print(sort(["b", "c", "a"]))\nprint(sort([2.5, 1.5]))\nlet words = ["a", "b"]\nreverse(words)\nprint(words)\nprint(slice(["a", "b", "c"], 1, 2))\nprint(slice([1.5, 2.5, 3.5], 0, 2))\nprint(join(["a", "b"]))\nprint(join([1, 2], "-"))\nprint(join([1.5, 2], "+"))\n')
