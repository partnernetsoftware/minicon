write(artDir + "/wasm-loopcap.bxs", 'for s in ["a", "bb"] { print(fn() { return s + "!" }()) }\nlet o = {x: 1, y: 2}\nfor k in o { print(fn() { return k }()) }\nfor k, v in o { print(fn() { return k + str(v) }()) }\nfor i in range(2) { print(fn() { return i * 5 }()) }\n')
