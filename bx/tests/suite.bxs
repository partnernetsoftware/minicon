}
write(artDir + "/wasm-clo.bxs", 'fn adder(n) { return fn(x) { return x + n } }\nlet add2 = adder(2)\nprint(add2(5))\nfn counter() {\n  let n = 0\n  return fn() { n = n + 1; return n }\n}\nlet c = counter()\nprint(c())\nprint(c())\nlet d = counter()\nprint(d())\nprint(c())\nfn compose(f, x) { return f(x) }\nprint(compose(fn(y) { return y * 3 }, 4))\nlet chain = fn(a) { return fn(b) { return a + "|" + b } }\nprint(chain("x")("y"))\n')
