write(artDir + "/wasm-clocap.bxs", 'fn scale_all(base) {\n  let factor = 2\n  return map([1, 2, 3], fn(x) { return x * factor + base })\n}\nfor v in scale_all(10) { print(v) }\nfn keep(base) {\n  let limit = 3\n  return filter([1, 2, 4, 5], fn(x) { return x + base > limit })\n}\nfor v in keep(0) { print(v) }\nfn total(base) {\n  let extra = 5\n  return reduce([1, 2, 3], fn(a, x) { return a + x + extra }, base)\n}\nprint(total(100))\nfor i in range(3) {\n  print(fn() { return i }())\n}\nfn loopy() {\n  for v in [10, 20] {\n    let f = fn() { return v + 1 }\n    print(f())\n  }\n}\nloopy()\n')
