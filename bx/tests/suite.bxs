write(artDir + "/wasm-objb.bxs", 'let o = {a: 1, b: 2}\nfor k in keys(o) { print(k) }\nfor v in values(o) { print(v) }\nprint(has(o, "a"))\nprint(has(o, "z"))\nprint(get(o, "b"))\nprint(get(o, "z", 99))\nprint(join(keys(o), "+"))\n')
let wasmObjb = exec([BX, "build", "--wasm", artDir + "/wasm-objb.bxs", "-o", artDir + "/wasm-objb.wasm"])
let wasmObjbRun = exec([BX, "run", artDir + "/wasm-objb.wasm"])
let wasmObjbVm = exec([BX, "run", artDir + "/wasm-objb.bxs"])
if (wasmObjb.code == 0 && wasmObjbRun.out == wasmObjbVm.out && wasmObjbRun.out.trim() == "a\nb\n1\n2\ntrue\nfalse\n2\n99\na+b") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("wasm record builtins\n    wasm=" + json(wasmObjbRun.out) + " vm=" + json(wasmObjbVm.out) + " err=" + json(wasmObjbRun.err))
}
write(artDir + "/wasm-bad.bxs", 'fn outer() {\n  let n = 5\n  let f = fn(x) { return x + n }\n  return f(1)\n}\nprint(outer())\n')
let wasmBad = exec([BX, "build", "--wasm", artDir + "/wasm-bad.bxs", "-o", artDir + "/wasm-bad.wasm"])
if (wasmBad.code == 1 && wasmBad.err.contains("cannot capture outer variables")) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("wasm target rejects unsupported source\n    code=" + wasmBad.code)
}

// closures capture the enclosing function's visible locals by value
check("closure factory", "15", ["eval", "fn adder(n) { return fn(x) { return x + n } } let f = adder(10); f(5)"])
mkdir(artDir)
let bxb = artDir + "/suite-loops.bxb"
let built = run(["build", __dir__ + "/cases/loops.bxs", "-o", bxb])
if (built.code == 0 && exists(bxb)) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("build bytecode\n    stderr: " + json(built.err.trim()))
}
check("run compiled .bxb", loops, ["run", bxb])
checkContains("dis shows main chunk", "<main>", ["dis", bxb])

let argvBxb = artDir + "/suite-argv.bxb"
let builtArgv = run(["build", __dir__ + "/cases/argv.bxs", "-o", argvBxb])
if (builtArgv.code == 0) {
  check("compiled argv script", '["x"]', ["run", argvBxb, "x"])
} else {
  casesFail += 1
  failures.push("build argv bytecode\n    stderr: " + json(builtArgv.err.trim()))
}

// A source run compiles once, leaves the bytecode beside the script, and the
// second run executes that cached binary instead of re-parsing.
let cacheScript = artDir + "/cache-probe.bxs"
write(cacheScript, 'print("cached")\n')
let probe = run(["run", cacheScript])
let cacheDir = artDir + "/.bxcache"
let cacheFiles = list(cacheDir)
if (probe.code == 0 && probe.out.trim() == "cached" && len(cacheFiles) > 0) {
  casesOk += 1
} else {
  casesFail += 1
  failures.push("cache written beside the script\n    got exit " + probe.code + " stdout " + json(probe.out.trim()) + " cache entries " + len(cacheFiles))
}
let warm = run(["run", cacheScript])
check("cached run still executes", "cached", ["run", cacheScript])
// Editing an included file must invalidate the cached bytecode: `use` inlines
// the file, so the key has to cover the dependency, not just the main script.
let useDir = artDir + "/use-cache"
mkdir(useDir)
write(useDir + "/lib.bxs", 'fn v() { return 1 }\n')
write(useDir + "/main.bxs", 'use "lib.bxs"\nprint(v())\n')
let stale = run(["run", useDir + "/main.bxs"])
write(useDir + "/lib.bxs", 'fn v() { return 2 }\n')
let fresh = run(["run", useDir + "/main.bxs"])
if (stale.out.trim() == "1" && fresh.out.trim() == "2") {
  casesOk += 1
} else {
  casesFail += 1
  failures.push(
    "include edit invalidates the cache\n    first=" + json(stale.out.trim()) + " after-edit=" + json(fresh.out.trim())
  )
}

// ---------------------------------------------------------------------------
// errors
// ---------------------------------------------------------------------------

print("errors")
checkFail("undefined variable", "undefined variable 'nope'", 1, ["eval", "nope()"])
checkFail("syntax error has line", "line 1", 1, ["eval", "let = 3"])
checkFail("runtime error has line", "err.bxs(3)", 1, ["run", __dir__ + "/cases/err.bxs"])
checkFail("assert message", "boom", 1, ["eval", 'assert(1 == 2, "boom")'])
checkFail("exec missing binary", "cannot run", 1, ["eval", 'exec("definitely-not-a-real-binary-xyz")'])
checkFail("unknown command", "unknown command", 2, ["frobnicate"])

// ---------------------------------------------------------------------------
// report
// ---------------------------------------------------------------------------

print("")
if (casesFail == 0) {
  print("PASS  " + casesOk + " checks")
  exit(0)
}
print("FAIL  " + casesOk + " passed, " + casesFail + " failed")
for f in failures {
  print("")
  print("  " + f)
}
exit(1)
