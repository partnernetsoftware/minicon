write(artDir + "/wasm-arrb2.bxs", 'print(index_of([1, 2, 3], 2))\nprint(index_of([1, 2], 9))\nprint(index_of(["a", "b"], "b"))\nprint(["a", "b"].contains("b"))\nprint([1, 2, 3].contains(4))\nprint([1, 2].index_of(2))\nprint(min([3, 1, 2]))\nprint(max([3, 1, 2]))\nprint(min(["b", "a", "c"]))\nprint(max(["b", "a"]))\nprint(index_of([], 1))\nprint("abc".index_of("b"))\nprint("abc".contains("bc"))\n')
