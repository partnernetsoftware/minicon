write(artDir + "/wasm-maploopcap.bxs", 'let m = map_new()\nmap_set(m, "one", 1)\nmap_set(m, "two", 2)\nfor mk in m { print(fn() { return mk }()) }\nfor mk, mv in m { print(fn() { return mk + str(mv) }()) }\n')
