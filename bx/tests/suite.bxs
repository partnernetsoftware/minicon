write(artDir + "/wasm-arrobj.bxs", 'let xs = [{a: 1}, {a: 2}]\nprint(xs[0].a)\nprint(len(xs))\nfor r in xs { print(r.a) }\nxs[1] = {a: 9}\nprint(xs[-1].a)\nfor i, r in xs { print(i + r.a) }\nfn total(rows) {\n  let s = 0\n  for r in rows { s = s + r.a }\n  return s\n}\nprint(total([{a: 1}, {a: 2}, {a: 3}]))\n')
