write(dir + "/wasm-cache.bxs", 'print(1 + 2)\n')
test("wasm source runs reuse a module cache", fn() {
  let first = exec([bin, "run", "--wasm", dir + "/wasm-cache.bxs"])
  let second = exec([bin, "run", "--wasm", dir + "/wasm-cache.bxs"])
  assert(first.code == 0 && second.code == 0 && first.out == second.out, "outputs differ: " + json(first.out) + " vs " + json(second.out))
  assert(first.out.trim() == "3", "out=" + json(first.out))
  let cache = dir + "/.bxcache"
  assert(exists(cache), "no wasm cache directory at " + cache)
})
write(dir + "/wasm-words.bxs", 'let words = [["a"], ["b", "c"]]\nprint(words)\nprint(len(words[1]))\n')
test("wasm string array rows", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-words.bxs", "-o", dir + "/wasm-words.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-words.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-words.bxs"])
  assert(ran.code == 0 && ran.out == vm.out && ran.out.trim() == "[[\"a\"],[\"b\",\"c\"]]\n2", "wasm=" + json(ran.out) + " vm=" + json(vm.out))
})
test("wasm array-of-arrays and reduce", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-rows.bxs", "-o", dir + "/wasm-rows.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-rows.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-rows.bxs"])
  assert(ran.code == 0 && ran.out == vm.out && ran.out.trim() == "[1,5]\n3", "wasm=" + json(ran.out) + " vm=" + json(vm.out))
})
