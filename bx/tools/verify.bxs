// End-to-end verification of a bx binary or packed `.com`, written as bx tests
// so `bx test` owns the reporting and the exit code.
//
//   bx test tools/verify.bxs path/to/bx
//   ./minicon-bx-linux-x86_64.com test tools/verify.bxs minicon-bx-linux-x86_64.com
if (len(argv) < 1) {
  eprint("usage: bx test tools/verify.bxs <bx-binary-or-com>\n")
  exit(2)
}
let bin = argv[0]
let tmp = env("TEMP")
if (tmp == "" || tmp == null) { tmp = env("TMPDIR") }
if (tmp == "" || tmp == null) { tmp = cwd() }
let dir = tmp + "/bx-verify-" + str(now())
mkdir(dir)

// A launcher answers --com-info; a native binary does not. Detect by behaviour,
// not by the file name, because launchers get renamed to .exe on Windows.
test("container metadata or a native binary", fn() {
  let info = exec([bin, "--com-info"])
  if (info.code == 0 && info.out.contains("\"product\"")) {
    assert(info.out.contains("\"version\""), "com-info is missing version: " + info.out)
  } else {
    assert(info.code != 0, "native binary unexpectedly answered --com-info")
  }
})

test("version prints bx", fn() {
  let out = exec([bin, "version"])
  assert(out.code == 0 && starts_with(out.out.trim(), "bx "), "got " + out.out)
})

test("eval computes", fn() {
  let out = exec([bin, "eval", "6 * 7"])
  assert(out.code == 0 && out.out.trim() == "42", "got " + out.out + " " + out.err)
})

test("exit codes pass through", fn() {
  assert(exec([bin, "eval", "exit(3)"]).code == 3)
})

write(dir + "/ok.bxs", 'print(1)\n')
test("check compiles without running", fn() {
  let out = exec([bin, "check", dir + "/ok.bxs"])
  assert(out.code == 0 && out.out.contains("ok "), "got " + out.out + " " + out.err)
})

test("dis reads a script", fn() {
  let out = exec([bin, "dis", dir + "/ok.bxs"])
  assert(out.code == 0 && out.out.contains("chunk"), "got " + out.err)
})

write(dir + "/spin.bxs", 'while (true) { }\n')
test("--max-steps stops a runaway script", fn() {
  let out = exec([bin, "run", "--max-steps", "200000", dir + "/spin.bxs"])
  assert(out.code == 1 && out.err.contains("step limit"), "got " + out.err)
})

test("--timeout leaves normal runs alone", fn() {
  assert(exec([bin, "run", "--timeout", "5000", dir + "/ok.bxs"]).code == 0)
})

write(dir + "/filter.bxs", 'print(read("-").trim().upper())\n')
test("read(-) drains stdin", fn() {
  let out = exec([bin, "run", dir + "/filter.bxs"], {stdin: "hi"})
  assert(out.code == 0 && out.out.trim() == "HI", "got " + out.out)
})

write(dir + "/apply.bxs", 'print(json(patch(argv[0], read(argv[1]))))\n')
write(dir + "/target.txt", "a\nb\n")
write(dir + "/fix.diff", "--- a/target.txt\n+++ b/target.txt\n@@ -1,2 +1,2 @@\n a\n-b\n+B\n")
test("patch applies a unified diff", fn() {
  let out = exec([bin, "run", dir + "/apply.bxs", dir + "/target.txt", dir + "/fix.diff"])
  assert(out.code == 0 && read(dir + "/target.txt") == "a\nB\n", "file is " + json(read(dir + "/target.txt")))
})

test("spawn/wait works", fn() {
  let out = exec([bin, "eval", 'let h = spawn("echo hi", {shell: true}); let r = spawn_wait(h.id); r.out.trim()'])
  assert(out.code == 0 && out.out.trim() == "hi", "got " + out.out + " " + out.err)
})

write(dir + "/round.bxs", 'let f = fn(n) { return n * 2 }\nprint(f(21))\n')
test("build writes .bxb", fn() {
  let out = exec([bin, "build", dir + "/round.bxs", "-o", dir + "/round.bxb"])
  assert(out.code == 0 && exists(dir + "/round.bxb"), "got " + out.err)
})

test(".bxb runs", fn() {
  let out = exec([bin, "run", dir + "/round.bxb"])
  assert(out.code == 0 && out.out.trim() == "42", "got " + out.out + " " + out.err)
})

write(dir + "/lib.bxs", 'fn boom() {\n  return missing_name\n}\n')
write(dir + "/main.bxs", 'use "lib.bxs"\nboom()\n')
test("runtime errors name the include", fn() {
  let out = exec([bin, "run", dir + "/main.bxs"])
  assert(
    out.code == 1 && out.err.contains("lib.bxs") && out.err.contains("boom"),
    "got " + out.err
  )
})

write(dir + "/broken.bxs", 'break\n')
write(dir + "/main-broken.bxs", 'use "broken.bxs"\n')
test("include compile errors name the file", fn() {
  let out = exec([bin, "check", dir + "/main-broken.bxs"])
  assert(out.code == 1 && out.err.contains("broken.bxs"), "got " + out.err)
})

write(dir + "/wasm-num.bxs", 'let x = 2\nprint(x + 3)\nx = x * 2\nprint(x)\n')
test("wasm target builds a standard module", fn() {
  let out = exec([bin, "build", "--wasm", dir + "/wasm-num.bxs", "-o", dir + "/wasm-num.wasm"])
  assert(out.code == 0 && exists(dir + "/wasm-num.wasm"), "got " + out.err)
})
test("wasm module runs", fn() {
  let out = exec([bin, "run", dir + "/wasm-num.wasm"])
  assert(out.code == 0 && out.out.trim() == "5\n4", "got " + out.out + " " + out.err)
})
test("wasm check validates", fn() {
  let out = exec([bin, "check", dir + "/wasm-num.wasm"])
  assert(out.code == 0, "got " + out.err)
})
write(dir + "/wasm-str.bxs", 'print("hello " + "wasm")\nprint(6 * 7)\n')
test("wasm strings use linear memory", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-str.bxs", "-o", dir + "/wasm-str.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-str.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "hello wasm\n42", "got " + ran.out + " " + ran.err)
})
write(dir + "/wasm-arr.bxs", 'let a = [10, 20, 30]\nprint(a[0] + a[2])\nprint(len(a))\n')
test("wasm arrays use the prototype allocator", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-arr.bxs", "-o", dir + "/wasm-arr.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-arr.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "40\n3", "got " + ran.out + " " + ran.err)
})
write(dir + "/wasm-strap.bxs", 'let s = "hello "\nlet t = s + "wasm"\nprint(t)\nprint(len(t))\n')
write(dir + "/wasm-rec.bxs", 'let o = {a: 10, b: 20}\nprint(o.a + o.b)\n')
write(dir + "/wasm-flow.bxs", 'let i = 0\nlet sum = 0\nwhile (i < 6) {\n  i = i + 1\n  sum = sum + i\n}\nprint(sum)\n')
write(dir + "/wasm-fn.bxs", 'fn fact(n) {\n  if (n < 2) { return 1 }\n  return n * fact(n - 1)\n}\nprint(fact(5))\n')
write(dir + "/wasm-args.bxs", 'print(argc())\nprint(arg(0))\n')
write(dir + "/wasm-fs.bxs", 'print(write_file("wasm-fs.txt", "payload"))\nprint(read_file("wasm-fs.txt"))\n')
write(dir + "/wasm-proc.bxs", 'print(run("echo hi"))\nprint(capture("echo hi"))\n')
write(dir + "/wasm-cmp.bxs", 'print(7 % 2)\nlet x = 5\nif (x <= 5) { print(10) }\n')
test("wasm backend matches the VM on generated programs", fn() {
  let out = exec([bin, "run", __dir__ + "/wasm-diff.bxs", bin, "8"])
  assert(out.code == 0 && out.out.contains("PASS 8 differential cases"), "got " + out.out + " " + out.err)
})
write(dir + "/wasm-flt.bxs", 'print(7 / 2)\nprint(6 / 2)\n')
write(dir + "/wasm-rich.bxs", 'fn build() {\n  let a = [7, 8]\n  print(a[1])\n}\nbuild()\n')
write(dir + "/wasm-web.bxs", 'console_log("web")\nconsole_log(7)\n')
write(dir + "/wasm-gl.bxs", 'gl_create(1, 1)\ngl_clear_color(0.0, 1.0, 0.0, 1.0)\ngl_clear()\nprint(gl_pixel(0, 0))\n')
write(dir + "/wasm-inf.bxs", 'let i = 0\nlet s = 0\nwhile (i < 1) { s = s + 1 }\n')
write(dir + "/wasm-fnf.bxs", 'fn half(x) { return x / 2 }\nprint(half(7))\n')
write(dir + "/wasm-richp.bxs", 'fn tag(s) { return s + "?" }\nprint(tag("ok"))\n')
write(dir + "/wasm-strcmp.bxs", 'if ("abc" < "abd") { print(1) }\n')
write(dir + "/wasm-push.bxs", 'let a = [1]\na.push(2)\nprint(len(a))\n')
write(dir + "/wasm-forin.bxs", 'let a = [1, 2, 3]\nlet s = 0\nfor v in a { s = s + v }\nprint(s)\n')
write(dir + "/wasm-conv.bxs", 'print(str(42))\nprint(int("7"))\nlet a = [1, 2, 3]\na.pop()\nprint(a.len())\n')
write(dir + "/wasm-util.bxs", 'let t = now()\nif (t > 0) { print(1) }\nmkdir("util-made")\nprint(file_exists("util-made"))\n')
write(dir + "/wasm-map.bxs", 'let m = map_new()\nmap_set(m, "a", 3)\nmap_set(m, "b", 4)\nprint(map_len(m))\nprint(map_get(m, "a") + map_get(m, "b"))\n')
write(dir + "/wasm-mapfor.bxs", 'let m = map_new()\nmap_set(m, "k", 9)\nfor k, v in m { print(k)\nprint(v) }\n')
test("wasm maps iterate", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-mapfor.bxs", "-o", dir + "/wasm-mapfor.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-mapfor.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "k\n9", "got " + json(ran.out) + " " + ran.err)
})
test("wasm dynamic maps", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-map.bxs", "-o", dir + "/wasm-map.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-map.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "2\n7", "got " + json(ran.out) + " " + ran.err)
})
test("wasm native utilities", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-util.bxs", "-o", dir + "/wasm-util.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-util.wasm"], { cwd: dir })
  assert(ran.code == 0 && ran.out.trim() == "1\n1", "got " + json(ran.out) + " " + ran.err)
})
test("wasm str/int conversions and pop", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-conv.bxs", "-o", dir + "/wasm-conv.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-conv.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-conv.bxs"])
  assert(ran.code == 0 && ran.out == vm.out && ran.out.trim() == "42\n7\n2", "wasm=" + json(ran.out) + " vm=" + json(vm.out))
})
test("wasm for-in over arrays", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-forin.bxs", "-o", dir + "/wasm-forin.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-forin.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-forin.bxs"])
  assert(ran.code == 0 && ran.out == vm.out && ran.out.trim() == "6", "wasm=" + json(ran.out) + " vm=" + json(vm.out))
})
test("wasm arrays grow with push", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-push.bxs", "-o", dir + "/wasm-push.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-push.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-push.bxs"])
  assert(ran.code == 0 && ran.out == vm.out && ran.out.trim() == "2", "wasm=" + json(ran.out) + " vm=" + json(vm.out))
})
test("wasm string comparisons", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-strcmp.bxs", "-o", dir + "/wasm-strcmp.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-strcmp.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-strcmp.bxs"])
  assert(ran.code == 0 && ran.out == vm.out && ran.out.trim() == "1", "wasm=" + json(ran.out) + " vm=" + json(vm.out))
})
test("wasm string function results", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-richp.bxs", "-o", dir + "/wasm-richp.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-richp.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-richp.bxs"])
  assert(ran.code == 0 && ran.out == vm.out && ran.out.trim() == "ok?", "wasm=" + json(ran.out) + " vm=" + json(vm.out))
})
test("wasm float function parameters", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-fnf.bxs", "-o", dir + "/wasm-fnf.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-fnf.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-fnf.bxs"])
  assert(ran.code == 0 && ran.out == vm.out && ran.out.trim() == "3.5", "wasm=" + json(ran.out) + " vm=" + json(vm.out))
})
test("wasm execution budgets", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-inf.bxs", "-o", dir + "/wasm-inf.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let stopped = exec([bin, "run", "--max-steps", "5000", dir + "/wasm-inf.wasm"])
  assert(stopped.code == 1 && stopped.err.contains("step budget"), "got " + stopped.code + " " + stopped.err)
})
test("wasm webgl clears and reads pixels", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-gl.bxs", "-o", dir + "/wasm-gl.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-gl.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "16711935", "got " + json(ran.out) + " " + ran.err)
})
test("wasm web.* console works", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-web.bxs", "-o", dir + "/wasm-web.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-web.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "web\n7", "got " + json(ran.out) + " " + ran.err)
})
test("wasm browser demo runs under node when available", fn() {
  let probe = exec(["node", "--version"])
  if (probe.code != 0) {
    return
  }
  write(dir + "/wasm-demo.bxs", 'print(6 * 7)\nprint("hi")\n')
  let built = exec([bin, "build", "--wasm", "--html", dir + "/wasm-demo.bxs", "-o", dir + "/wasm-demo.html"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec(["node", dir + "/wasm-demo.js"])
  assert(ran.code == 0 && ran.out.trim() == "42\nhi", "got " + json(ran.out) + " " + ran.err)
})
test("wasm functions hold array/string locals", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-rich.bxs", "-o", dir + "/wasm-rich.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-rich.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "8", "got " + ran.out + " " + ran.err)
})
test("wasm check --json describes the module", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-num.bxs", "-o", dir + "/wasm-json.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let out = exec([bin, "check", dir + "/wasm-json.wasm", "--json"])
  assert(out.code == 0, "check failed: " + out.err)
  assert(out.out.contains("\"imports\"") && out.out.contains("env.print_i64") && out.out.contains("_start"), "got " + out.out)
})
test("wasm float division matches the VM", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-flt.bxs", "-o", dir + "/wasm-flt.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let wasm = exec([bin, "run", dir + "/wasm-flt.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-flt.bxs"])
  assert(wasm.code == 0 && wasm.out == vm.out && wasm.out.trim() == "3.5\n3", "wasm=" + json(wasm.out) + " vm=" + json(vm.out))
})
test("wasm comparisons and modulo", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-cmp.bxs", "-o", dir + "/wasm-cmp.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-cmp.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "1\n10", "got " + ran.out + " " + ran.err)
})
test("wasm native process ABI", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-proc.bxs", "-o", dir + "/wasm-proc.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-proc.wasm"])
  assert(ran.code == 0 && ran.out.contains("0") && ran.out.contains("hi"), "got " + ran.out + " " + ran.err)
})
test("wasm filesystem ABI round-trips", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-fs.bxs", "-o", dir + "/wasm-fs.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-fs.wasm"], { cwd: dir })
  assert(ran.code == 0 && ran.out.trim() == "0\npayload", "got " + ran.out + " " + ran.err)
})
test("wasm modules receive argv", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-args.bxs", "-o", dir + "/wasm-args.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-args.wasm", "hello"])
  assert(ran.code == 0 && ran.out.trim() == "1\nhello", "got " + ran.out + " " + ran.err)
})
test("wasm user functions recurse", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-fn.bxs", "-o", dir + "/wasm-fn.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-fn.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "120", "got " + ran.out + " " + ran.err)
})
test("wasm control flow runs", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-flow.bxs", "-o", dir + "/wasm-flow.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-flow.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "21", "got " + ran.out + " " + ran.err)
})
test("wasm records use the in-module heap", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-rec.bxs", "-o", dir + "/wasm-rec.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-rec.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "30", "got " + ran.out + " " + ran.err)
})
test("wasm runtime strings concatenate", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-strap.bxs", "-o", dir + "/wasm-strap.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-strap.wasm"])
  assert(ran.code == 0 && ran.out.trim() == "hello wasm\n10", "got " + ran.out + " " + ran.err)
