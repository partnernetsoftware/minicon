write(dir + "/wasm-sortcmp.bxs", 'let a = [3, 1, 2]\nlet b = sort(a, fn(x, y) { return x - y })\nprint(a[0])\nfor v in sort([2, 1], fn(x, y) { return y - x }) { print(v) }\n')
write(dir + "/wasm-push2.bxs", 'let xs = ["a"]\npush(xs, "b")\nfor v in xs { print(v) }\nlet rs = [{a: 1}]\npush(rs, {a: 2})\nprint(rs[1].a)\nlet e = {}\nprint(len(keys(merge(e, {x: 4}))))\n')
