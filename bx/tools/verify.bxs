write(dir + "/wasm-clo2.bxs", 'fn adder(n) { return fn(x) { return x + n } }\nlet add3 = adder(3)\nprint(add3(4))\nfn counter() { let n = 0; return fn() { n = n + 1; return n } }\nlet c = counter()\nprint(c())\nprint(c())\n')
