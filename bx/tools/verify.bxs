write(dir + "/wasm-fs.bxs", 'print(write_file("wasm-fs.txt", "payload"))\nprint(read_file("wasm-fs.txt"))\n')
write(dir + "/wasm-proc.bxs", 'print(run("echo hi"))\nprint(capture("echo hi"))\n')
write(dir + "/wasm-cmp.bxs", 'print(7 % 2)\nlet x = 5\nif (x <= 5) { print(10) }\n')
test("wasm backend matches the VM on generated programs", fn() {
  let out = exec([bin, "run", __dir__ + "/wasm-diff.bxs", bin, "8"])
  assert(out.code == 0 && out.out.contains("PASS 8 differential cases"), "got " + out.out + " " + out.err)
})
