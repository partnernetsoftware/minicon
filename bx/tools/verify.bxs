test("wasm browser demo runs under node when available", fn() {
  let probe = exec(["node", "--version"])
  if (probe.code != 0) {
    return
  }
  write(dir + "/wasm-demo.bxs", 'print(6 * 7)\nprint("hi")\n')
  let built = exec([bin, "build", "--wasm", "--html", dir + "/wasm-demo.bxs", "-o", dir + "/wasm-demo.html"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec(["node", dir + "/wasm-demo.js"])
  assert(ran.code == 0 && ran.out.trim() == "42\nhi", "got " + json(ran.out) + " " + ran.err)
})
