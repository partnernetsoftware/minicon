test("wasm runtime boundary aborts", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-oob.bxs", "-o", dir + "/wasm-oob.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-oob.wasm"])
  assert(ran.code == 1 && ran.err.contains("index out of bounds"), "got " + ran.code + " " + json(ran.err))
  write(dir + "/wasm-div0.bxs", 'print(7 / 0)\n')
  let div = exec([bin, "build", "--wasm", dir + "/wasm-div0.bxs", "-o", dir + "/wasm-div0.wasm"])
  assert(div.code == 0, "build failed: " + div.err)
  let divRun = exec([bin, "run", dir + "/wasm-div0.wasm"])
  assert(divRun.code == 1 && divRun.err.contains("division by zero"), "got " + divRun.code + " " + json(divRun.err))
})
