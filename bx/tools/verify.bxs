// End-to-end verification of a bx binary or packed `.com`, written as bx tests
// so `bx test` owns the reporting and the exit code.
//
//   bx test tools/verify.bxs path/to/bx
//   ./minicon-bx-linux-x86_64.com test tools/verify.bxs minicon-bx-linux-x86_64.com
if (len(argv) < 1) {
  eprint("usage: bx test tools/verify.bxs <bx-binary-or-com>\n")
  exit(2)
}
let bin = argv[0]
let tmp = env("TEMP")
if (tmp == "" || tmp == null) { tmp = env("TMPDIR") }
if (tmp == "" || tmp == null) { tmp = cwd() }
let dir = tmp + "/bx-verify-" + str(now())
mkdir(dir)

// A launcher answers --com-info; a native binary does not. Detect by behaviour,
// not by the file name, because launchers get renamed to .exe on Windows.
test("container metadata or a native binary", fn() {
  let info = exec([bin, "--com-info"])
  if (info.code == 0 && info.out.contains("\"product\"")) {
    assert(info.out.contains("\"version\""), "com-info is missing version: " + info.out)
  } else {
    assert(info.code != 0, "native binary unexpectedly answered --com-info")
  }
})

test("version prints bx", fn() {
  let out = exec([bin, "version"])
  assert(out.code == 0 && starts_with(out.out.trim(), "bx "), "got " + out.out)
})

test("eval computes", fn() {
  let out = exec([bin, "eval", "6 * 7"])
  assert(out.code == 0 && out.out.trim() == "42", "got " + out.out + " " + out.err)
})

test("exit codes pass through", fn() {
  assert(exec([bin, "eval", "exit(3)"]).code == 3)
})

write(dir + "/ok.bxs", 'print(1)\n')
test("check compiles without running", fn() {
  let out = exec([bin, "check", dir + "/ok.bxs"])
  assert(out.code == 0 && out.out.contains("ok "), "got " + out.out + " " + out.err)
})

test("dis reads a script", fn() {
  let out = exec([bin, "dis", dir + "/ok.bxs"])
  assert(out.code == 0 && out.out.contains("chunk"), "got " + out.err)
})

write(dir + "/spin.bxs", 'while (true) { }\n')
test("--max-steps stops a runaway script", fn() {
  let out = exec([bin, "run", "--max-steps", "200000", dir + "/spin.bxs"])
  assert(out.code == 1 && out.err.contains("step limit"), "got " + out.err)
})

test("--timeout leaves normal runs alone", fn() {
  assert(exec([bin, "run", "--timeout", "5000", dir + "/ok.bxs"]).code == 0)
})

write(dir + "/filter.bxs", 'print(read("-").trim().upper())\n')
test("read(-) drains stdin", fn() {
  let out = exec([bin, "run", dir + "/filter.bxs"], {stdin: "hi"})
  assert(out.code == 0 && out.out.trim() == "HI", "got " + out.out)
})

write(dir + "/apply.bxs", 'print(json(patch(argv[0], read(argv[1]))))\n')
write(dir + "/target.txt", "a\nb\n")
write(dir + "/fix.diff", "--- a/target.txt\n+++ b/target.txt\n@@ -1,2 +1,2 @@\n a\n-b\n+B\n")
test("patch applies a unified diff", fn() {
  let out = exec([bin, "run", dir + "/apply.bxs", dir + "/target.txt", dir + "/fix.diff"])
  assert(out.code == 0 && read(dir + "/target.txt") == "a\nB\n", "file is " + json(read(dir + "/target.txt")))
})

test("spawn/wait works", fn() {
  let out = exec([bin, "eval", 'let h = spawn("echo hi", {shell: true}); let r = spawn_wait(h.id); r.out.trim()'])
  assert(out.code == 0 && out.out.trim() == "hi", "got " + out.out + " " + out.err)
})

write(dir + "/round.bxs", 'let f = fn(n) { return n * 2 }\nprint(f(21))\n')
test("build writes .bxb", fn() {
  let out = exec([bin, "build", dir + "/round.bxs", "-o", dir + "/round.bxb"])
  assert(out.code == 0 && exists(dir + "/round.bxb"), "got " + out.err)
})

test(".bxb runs", fn() {
  let out = exec([bin, "run", dir + "/round.bxb"])
  assert(out.code == 0 && out.out.trim() == "42", "got " + out.out + " " + out.err)
})

write(dir + "/lib.bxs", 'fn boom() {\n  return missing_name\n}\n')
write(dir + "/main.bxs", 'use "lib.bxs"\nboom()\n')
test("runtime errors name the include", fn() {
  let out = exec([bin, "run", dir + "/main.bxs"])
  assert(
    out.code == 1 && out.err.contains("lib.bxs") && out.err.contains("boom"),
    "got " + out.err
  )
})

write(dir + "/broken.bxs", 'break\n')
write(dir + "/main-broken.bxs", 'use "broken.bxs"\n')
test("include compile errors name the file", fn() {
  let out = exec([bin, "check", dir + "/main-broken.bxs"])
  assert(out.code == 1 && out.err.contains("broken.bxs"), "got " + out.err)
})

test("language smoke (closures, pairs, interpolation)", fn() {
  let out = exec([bin, "eval", 'fn make() { let n = 0; return fn() { n = n + 1; return n } } let c = make(); c(); c(); let s = ""; for k, v in {a: 1} { s = k + str(v) }; s + " " + str(c())'])
  assert(out.code == 0 && out.out.trim() == "a1 3", "got " + out.out + " " + out.err)
})