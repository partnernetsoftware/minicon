test("G1 target selection", fn() {
  let wasm = exec([bin, "build", "--target", "wasm", dir + "/g1.bxs", "-o", dir + "/g1-target.wasm"])
  assert(wasm.code == 0, "build failed: " + wasm.err)
  let env = exec([bin, "run", dir + "/g1.bxs"], { env: { BX_TARGET: "wasm" } })
  let vm = exec([bin, "run", dir + "/g1.bxs"])
  assert(env.code == 0 && env.out == vm.out && env.out.trim() == "7", "env=" + json(env.out) + " vm=" + json(vm.out))
  let bad = exec([bin, "build", "--target", "nope", dir + "/g1.bxs"])
  assert(bad.code == 2 && bad.err.contains("unknown target"), "invalid target: " + json(bad.err))
})
