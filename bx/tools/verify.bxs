test("wasm record arrays", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-arrobj.bxs", "-o", dir + "/wasm-arrobj.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-arrobj.wasm"])
  let vm = exec([bin, "run", dir + "/wasm-arrobj.bxs"])
  assert(ran.code == 0 && ran.out == vm.out && ran.out.trim() == "3\n5", "wasm=" + json(ran.out) + " vm=" + json(vm.out))
})
