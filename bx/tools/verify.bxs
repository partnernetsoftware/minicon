write(dir + "/wasm-iofail.bxs", 'print(read_file("C:/definitely-missing-bx-file.txt"))\n')
test("wasm IO failures are explicit", fn() {
  let built = exec([bin, "build", "--wasm", dir + "/wasm-iofail.bxs", "-o", dir + "/wasm-iofail.wasm"])
  assert(built.code == 0, "build failed: " + built.err)
  let ran = exec([bin, "run", dir + "/wasm-iofail.wasm"])
  assert(ran.code == 1 && ran.err.contains("cannot read"), "got " + ran.code + " " + json(ran.err))
  write(dir + "/wasm-mapfull.bxs", 'let m = map_new()\nlet i = 0\nwhile (i < 65) {\n  map_set(m, "k" + str(i), i)\n  i = i + 1\n}\n')
  let full = exec([bin, "build", "--wasm", dir + "/wasm-mapfull.bxs", "-o", dir + "/wasm-mapfull.wasm"])
  assert(full.code == 0, "build failed: " + full.err)
  let fullRun = exec([bin, "run", dir + "/wasm-mapfull.wasm"])
  assert(fullRun.code == 1 && fullRun.err.contains("map is full"), "got " + fullRun.code + " " + json(fullRun.err))
})
