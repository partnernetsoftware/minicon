// Collection differential tester: generated programs are run by bx's VM and by
// the wasm backend, and the outputs must match byte-for-byte.
//
//   bx run tools/wasm-diff-coll.bxs path/to/bx [cases] [seed]
//
// Only collection shapes the wasm target claims to support are generated
// (int/float/string arrays, text rows, int rows, records, maps over them and
// closure captures), so a mismatch is an implementation bug rather than an
// unsupported feature.
if (len(argv) < 1) {
  eprint("usage: bx run tools/wasm-diff-coll.bxs <bx-binary-or-com> [cases] [seed]\n")
  exit(2)
}
let bin = argv[0]
let cases = 24
if (len(argv) > 1) {
  cases = int(argv[1])
}
let tmp = env("TEMP")
if (tmp == "" || tmp == null) {
  tmp = env("TMPDIR")
}
if (tmp == "" || tmp == null) {
  tmp = cwd()
}
let dir = tmp + "/bx-wasm-diff-coll-" + str(now())
mkdir(dir)

let seed = 987654321
if (len(argv) > 2) {
  seed = int(argv[2])
  if (seed <= 0) {
    seed = 987654321
  }
}
fn next() {
  seed = (seed * 48271) % 2147483647
  if (seed == 0) {
    seed = 12345
  }
  return seed
}
fn pick(n) {
  return next() % n
}
fn num() {
  return str(1 + pick(9))
}
fn ints() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + num()
  }
  return text + "]"
}
fn floats() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + num() + "." + str(pick(9))
  }
  return text + "]"
}
fn strings() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + "\"s" + str(pick(5)) + "\""
  }
  return text + "]"
}
fn records() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + "{a: " + num() + "}"
  }
  return text + "]"
}
fn int_rows() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + ints()
  }
  return text + "]"
}
fn text_rows() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + strings()
  }
  return text + "]"
}
fn int_ops(lines, name) {
  let choice = pick(16)
  if (choice == 0) {
    lines.push("print(len(" + name + "))")
  } else if (choice == 1) {
    lines.push("print(" + name + ")")
  } else if (choice == 2) {
    lines.push("print(" + name + "[0])")
    lines.push("print(" + name + "[-1])")
    lines.push("print(" + name + ".len())")
  } else if (choice == 3) {
    lines.push("print(sum(" + name + "))")
  } else if (choice == 4) {
    lines.push("print(min(" + name + "))")
  } else if (choice == 5) {
    lines.push("print(max(" + name + "))")
  } else if (choice == 6) {
    lines.push("print(sort(" + name + "))")
  } else if (choice == 7) {
    lines.push("print(reverse(" + name + "))")
  } else if (choice == 8) {
    lines.push("print(slice(" + name + ", 0, 2))")
  } else if (choice == 9) {
    lines.push("print(join(" + name + ", \",\"))")
  } else if (choice == 10) {
    lines.push("print(map(" + name + ", fn(x) { return x * 2 }))")
  } else if (choice == 11) {
    lines.push("print(filter(" + name + ", fn(x) { return x > " + num() + " }))")
  } else if (choice == 12) {
    lines.push("print(reduce(" + name + ", fn(acc, x) { return acc + x }, 0))")
    lines.push("print(float(\"" + num() + "." + str(pick(9)) + "\"))")
    lines.push("print(int(\"" + num() + "\"))")
  } else if (choice == 13) {
    lines.push("print(index_of(" + name + ", " + num() + "))")
    lines.push("print(contains(" + name + ", " + name + "[0]))")
    lines.push("print(contains(" + name + ", " + num() + " + 100))")
    lines.push("print(float(" + num() + "))")
    lines.push("print(int(true))")
  } else if (choice == 14) {
    lines.push("push(" + name + ", " + num() + ")")
    lines.push("print(" + name + ")")
  } else {
    lines.push(name + "[0] = " + num())
    lines.push("print(" + name + ")")
    lines.push("for i, x in " + name + " {")
    lines.push("  if (x > " + num() + ") { break }")
    lines.push("  print(i)")
    lines.push("  print(x)")
    lines.push("}")
  }
}
fn float_ops(lines, name) {
  let choice = pick(10)
  if (choice == 0) {
    lines.push("print(len(" + name + "))")
  } else if (choice == 1) {
    lines.push("print(" + name + ")")
  } else if (choice == 2) {
    lines.push("print(sum(" + name + "))")
  } else if (choice == 3) {
    lines.push("print(min(" + name + "))")
  } else if (choice == 4) {
    lines.push("print(max(" + name + "))")
  } else if (choice == 5) {
    lines.push("print(sort(" + name + "))")
  } else if (choice == 6) {
    lines.push("print(reverse(" + name + "))")
  } else if (choice == 7) {
    lines.push("print(map(" + name + ", fn(x) { return x * 1.5 }))")
  } else if (choice == 8) {
    lines.push("print(reduce(" + name + ", fn(acc, x) { return acc + x }, 0.0))")
  } else {
    lines.push("print(index_of(" + name + ", " + num() + ".5))")
  }
}
fn string_ops(lines, name) {
  let choice = pick(11)
  if (choice == 0) {
    lines.push("print(len(" + name + "))")
  } else if (choice == 1) {
    lines.push("print(" + name + ")")
  } else if (choice == 2) {
    lines.push("print(" + name + "[0])")
    lines.push("print(upper(" + name + "[0]))")
    lines.push("print(index_of(" + name + "[0], \"s\"))")
  } else if (choice == 3) {
    lines.push("print(join(" + name + ", \"-\"))")
  } else if (choice == 4) {
    lines.push("print(sort(" + name + "))")
    lines.push("print(contains(" + name + ", " + name + "[0]))")
  } else if (choice == 5) {
    lines.push("print(reverse(" + name + "))")
  } else if (choice == 6) {
    lines.push("print(slice(" + name + ", 0, 2))")
  } else if (choice == 7) {
    lines.push("print(map(" + name + ", fn(x) { return len(x) }))")
  } else if (choice == 8) {
    lines.push("print(filter(" + name + ", fn(x) { return len(x) > 1 }))")
  } else if (choice == 9) {
    lines.push("push(" + name + ", \"z\")")
    lines.push("print(" + name + ")")
  } else {
    lines.push("print(" + name + "[0] == \"s1\" ? \"one\" : \"other\")")
    lines.push("for s in " + name + " {")
    lines.push("  if (s == \"s2\") { continue }")
    lines.push("  print(s)")
    lines.push("}")
  }
}
fn record_ops(lines, name) {
  let choice = pick(8)
  if (choice == 0) {
    lines.push("print(len(" + name + "))")
  } else if (choice == 1) {
    lines.push("print(" + name + ")")
    lines.push("print(" + name + "[0].a)")
  } else if (choice == 2) {
    lines.push("print(map(" + name + ", fn(x) { return x.a }))")
  } else if (choice == 3) {
    lines.push("print(filter(" + name + ", fn(x) { return x.a > " + num() + " }))")
  } else if (choice == 4) {
    lines.push("print(sort(" + name + ", fn(x, y) { return x.a - y.a }))")
  } else if (choice == 5) {
    lines.push("print(reduce(" + name + ", fn(acc, x) { return acc + x.a }, 0))")
  } else if (choice == 6) {
    lines.push("push(" + name + ", {a: " + num() + "})")
    lines.push("print(" + name + ")")
  } else {
    lines.push("each(" + name + ", fn(x) { print(x.a) })")
  }
}
fn int_row_ops(lines, name) {
  let choice = pick(8)
  if (choice == 0) {
    lines.push("print(len(" + name + "))")
  } else if (choice == 1) {
    lines.push("print(" + name + ")")
  } else if (choice == 2) {
    lines.push("print(" + name + "[0])")
    lines.push("print(" + name + "[0][0])")
  } else if (choice == 3) {
    lines.push("print(map(" + name + ", fn(r) { return len(r) }))")
  } else if (choice == 4) {
    lines.push("print(filter(" + name + ", fn(r) { return len(r) > 0 }))")
  } else if (choice == 5) {
    lines.push("print(reduce(" + name + ", fn(acc, r) { return acc + len(r) }, 0))")
  } else if (choice == 6) {
    lines.push("push(" + name + ", " + ints() + ")")
    lines.push("print(" + name + ")")
  } else {
    lines.push("for r in " + name + " {")
    lines.push("  print(len(r))")
    lines.push("}")
  }
}
fn text_row_ops(lines, name) {
  let choice = pick(8)
  if (choice == 0) {
    lines.push("print(len(" + name + "))")
  } else if (choice == 1) {
    lines.push("print(" + name + ")")
  } else if (choice == 2) {
    lines.push("print(" + name + "[0])")
    lines.push("print(" + name + "[0][0])")
  } else if (choice == 3) {
    lines.push("print(map(" + name + ", fn(r) { return len(r) }))")
  } else if (choice == 4) {
    lines.push("print(filter(" + name + ", fn(r) { return len(r) > 1 }))")
  } else if (choice == 5) {
    lines.push("print(reduce(" + name + ", fn(acc, r) { return acc + len(r) }, 0))")
  } else if (choice == 6) {
    lines.push("push(" + name + ", " + strings() + ")")
    lines.push("print(" + name + ")")
  } else {
    lines.push("print(sort(" + name + ", fn(x, y) { return len(x) - len(y) }))")
  }
}
fn gen() {
  let lines = []
  let used = 0
  lines.push("print(\"collection-differential\")")
  if (pick(2) == 0) {
    lines.push("let v" + str(used) + " = " + ints())
    int_ops(lines, "v" + str(used))
    used += 1
  }
  if (pick(2) == 0) {
    lines.push("let v" + str(used) + " = " + floats())
    float_ops(lines, "v" + str(used))
    used += 1
  }
  if (pick(2) == 0) {
    lines.push("let v" + str(used) + " = " + strings())
    string_ops(lines, "v" + str(used))
    used += 1
  }
  if (pick(3) == 0) {
    lines.push("let v" + str(used) + " = " + records())
    record_ops(lines, "v" + str(used))
    used += 1
  }
  if (pick(3) == 0) {
    lines.push("let v" + str(used) + " = " + int_rows())
    int_row_ops(lines, "v" + str(used))
    used += 1
  }
  if (pick(3) == 0) {
    lines.push("let v" + str(used) + " = " + text_rows())
    text_row_ops(lines, "v" + str(used))
    used += 1
  }
  if (pick(2) == 0) {
    lines.push("let base = " + num())
    lines.push("let f = fn(x) { return x + base }")
    lines.push("print(f(" + num() + "))")
  }
  let source = ""
  for (let i = 0; i < len(lines); i += 1) {
    source = source + lines[i] + "\n"
  }
  return source
}

let failures = 0
for (let c = 0; c < cases; c += 1) {
  let source = gen()
  let script = dir + "/case-" + str(c) + ".bxs"
  let module = dir + "/case-" + str(c) + ".wasm"
  write(script, source)
  let vm = exec([bin, "run", script])
  let built = exec([bin, "build", "--wasm", script, "-o", module])
  if (built.code != 0) {
    failures += 1
    eprint("case " + str(c) + ": wasm build failed: " + built.err + "\n--- source ---\n" + source)
    continue
  }
  let wasm = exec([bin, "run", module])
  if (vm.code != wasm.code || vm.out != wasm.out) {
    failures += 1
    eprint(
      "case " + str(c) + ": VM and wasm disagree\n" +
      "  vm code/out:   " + str(vm.code) + " " + json(vm.out) + "\n" +
      "  wasm code/out: " + str(wasm.code) + " " + json(wasm.out) + "\n" +
      "--- source ---\n" + source
    )
  }
}
if (failures == 0) {
  print("PASS " + str(cases) + " collection differential cases\n")
  exit(0)
}
print("FAIL " + str(failures) + " of " + str(cases) + " collection differential cases\n")
exit(1)
