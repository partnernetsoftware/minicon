// Array-method and null differential tester: generated programs run on the VM
// and on the wasm backend, and the outputs must match byte-for-byte.
//
//   bx run tools/wasm-diff-methods.bxs path/to/bx [cases] [seed]
//
// Only the surface the wasm target claims is generated (method forms
// `.join/.sort/.reverse/.pop`, slice/contains/index_of, map/filter/reduce/
// each, min/max/sum over int/float/string/bool arrays, plus null scalar
// semantics), so a mismatch is an implementation bug, not an unsupported
// feature. Record-array join and `.sort(cmp)` are intentionally absent.
if (len(argv) < 1) {
  eprint("usage: bx run tools/wasm-diff-methods.bxs <bx-binary-or-com> [cases] [seed]\n")
  exit(2)
}
let bin = argv[0]
let cases = 20
if (len(argv) > 1) {
  cases = int(argv[1])
}
let seed = 24681357
if (len(argv) > 2) {
  seed = int(argv[2])
  if (seed <= 0) {
    seed = 24681357
  }
}
let tmp = env("TEMP")
if (tmp == "" || tmp == null) {
  tmp = env("TMPDIR")
}
if (tmp == "" || tmp == null) {
  tmp = cwd()
}
let dir = tmp + "/bx-wasm-diff-methods-" + str(now())
mkdir(dir)
fn next() {
  seed = (seed * 48271) % 2147483647
  if (seed == 0) {
    seed = 12345
  }
  return seed
}
fn pick(n) {
  return next() % n
}
fn num() {
  return str(1 + pick(9))
}
fn ints() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + num()
  }
  return text + "]"
}
fn floats() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + num() + "." + str(pick(9))
  }
  return text + "]"
}
fn strings() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + "\"s" + str(pick(4)) + "\""
  }
  return text + "]"
}
fn bools() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + (pick(2) == 0 ? "true" : "false")
  }
  return text + "]"
}
fn int_methods(lines, name) {
  let choice = pick(14)
  if (choice == 0) {
    lines.push("print(" + name + ".join(\"-\"))")
    lines.push("print(" + name + ".join())")
  } else if (choice == 1) {
    lines.push("print(" + name + ".reverse())")
    lines.push("print(" + name + ".sort())")
  } else if (choice == 2) {
    lines.push("print(slice(" + name + ", 0, 2))")
    lines.push("print(" + name + ".slice(0, 2))")
    lines.push("print(" + name + ".slice(1))")
  } else if (choice == 3) {
    lines.push("print(" + name + ".contains(" + name + "[0]))")
    lines.push("print(" + name + ".index_of(" + name + "[0]))")
  } else if (choice == 4) {
    lines.push("print(" + name + ".pop())")
    lines.push("print(" + name + ")")
  } else if (choice == 5) {
    lines.push("print(map(" + name + ", fn(x) { return x + 1 }))")
  } else if (choice == 6) {
    lines.push("print(filter(" + name + ", fn(x) { return x > " + num() + " }))")
  } else if (choice == 7) {
    lines.push("print(reduce(" + name + ", fn(acc, x) { return acc + x }, 0))")
  } else if (choice == 8) {
    lines.push("each(" + name + ", fn(x) { print(x) })")
  } else if (choice == 9) {
    lines.push("print(sum(" + name + "))")
    lines.push("print(min(" + name + "))")
    lines.push("print(max(" + name + "))")
    lines.push("print(" + name + ".sum())")
    lines.push("print(" + name + ".min())")
    lines.push("print(" + name + ".max())")
  } else if (choice == 10) {
    lines.push("print(" + name + ")")
    lines.push("print(len(" + name + "))")
    lines.push("print(" + name + "[0])")
  } else {
    lines.push("print(str(" + name + "))")
    lines.push("print(json(" + name + "))")
    lines.push("print(\"v=$" + "{" + name + "}\")")
  }
}
fn str_methods(lines, name) {
  let choice = pick(9)
  if (choice == 0) {
    lines.push("print(" + name + ".join(\"|\"))")
    lines.push("print(" + name + ".join())")
  } else if (choice == 1) {
    lines.push("print(" + name + ".reverse())")
    lines.push("print(" + name + ".sort())")
  } else if (choice == 2) {
    lines.push("print(slice(" + name + ", 0, 2))")
    lines.push("print(" + name + ".slice(0, 2))")
  } else if (choice == 3) {
    lines.push("print(" + name + ".contains(" + name + "[0]))")
    lines.push("print(" + name + ".index_of(" + name + "[0]))")
  } else if (choice == 4) {
    lines.push("print(" + name + ".pop())")
    lines.push("print(" + name + ")")
  } else if (choice == 5) {
    lines.push("print(map(" + name + ", fn(x) { return len(x) }))")
  } else if (choice == 6) {
    lines.push("print(filter(" + name + ", fn(x) { return len(x) > 1 }))")
  } else if (choice == 7) {
    lines.push("print(join(split(join(" + name + ", \",\"), \",\"), \"-\"))")
  } else {
    lines.push("print(" + name + ".sort(fn(x, y) { return len(x) - len(y) }))")
    lines.push("print(" + name + ")")
    lines.push("print(str(" + name + "))")
    lines.push("print(json(" + name + "))")
  }
}
fn float_methods(lines, name) {
  let choice = pick(7)
  if (choice == 0) {
    lines.push("print(" + name + ".join(\"|\"))")
  } else if (choice == 1) {
    lines.push("print(" + name + ".reverse())")
    lines.push("print(" + name + ".sort())")
  } else if (choice == 2) {
    lines.push("print(slice(" + name + ", 0, 2))")
  } else if (choice == 3) {
    lines.push("print(" + name + ".contains(" + name + "[0]))")
    lines.push("print(" + name + ".index_of(" + name + "[0]))")
  } else if (choice == 4) {
    lines.push("print(sum(" + name + "))")
    lines.push("print(min(" + name + "))")
    lines.push("print(max(" + name + "))")
    lines.push("print(" + name + ".sum())")
    lines.push("print(" + name + ".min())")
    lines.push("print(" + name + ".max())")
    lines.push("print(" + name + ".slice(0, 2))")
  } else if (choice == 5) {
    lines.push("print(map(" + name + ", fn(x) { return x * 2.0 }))")
    lines.push("print(map(" + name + ", fn(x) { return x > 1.5 }))")
  } else {
    lines.push("print(reduce(" + name + ", fn(acc, x) { return acc + x }, 0.0))")
    lines.push("print(" + name + ".pop())")
  }
}
fn bool_methods(lines, name) {
  let choice = pick(9)
  if (choice == 0) {
    lines.push("print(" + name + ".join(\",\"))")
    lines.push("print(" + name + ".join())")
  } else if (choice == 1) {
    lines.push("print(" + name + ".reverse())")
    lines.push("print(" + name + ".sort())")
  } else if (choice == 2) {
    lines.push("print(slice(" + name + ", 0, 2))")
  } else if (choice == 3) {
    lines.push("print(" + name + ".contains(" + name + "[0]))")
    lines.push("print(" + name + ".index_of(" + name + "[0]))")
  } else if (choice == 4) {
    lines.push("print(" + name + ".pop())")
    lines.push("print(" + name + ")")
  } else if (choice == 5) {
    lines.push("print(map(" + name + ", fn(x) { return x }))")
    lines.push("print(map(" + name + ", fn(x) { return x ? 1 : 0 }))")
  } else if (choice == 6) {
    lines.push("print(filter(" + name + ", fn(x) { return !x }))")
  } else if (choice == 7) {
    lines.push("print(reduce(" + name + ", fn(acc, x) { return acc || x }, false))")
    lines.push("print(sum(" + name + "))")
    lines.push("print(min(" + name + "))")
    lines.push("print(max(" + name + "))")
    lines.push("print(" + name + ".sum())")
    lines.push("print(" + name + ".min())")
    lines.push("print(" + name + ".max())")
  } else {
    lines.push("print(" + name + ")")
    lines.push("print(str(" + name + "))")
    lines.push("print(json(" + name + "))")
    lines.push("print(\"v=$" + "{" + name + "}\")")
    lines.push("for v in " + name + " { print(v) }")
    lines.push("print(" + name + ".sort(fn(a, b) { return a == b ? 0 : (a ? 1 : -1) }))")
  }
}
fn records() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + "{a: " + num() + "}"
  }
  return text + "]"
}
fn int_rows() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + ints()
  }
  return text + "]"
}
fn text_rows() {
  let count = 1 + pick(3)
  let text = "["
  for (let i = 0; i < count; i += 1) {
    if (i > 0) {
      text = text + ", "
    }
    text = text + strings()
  }
  return text + "]"
}
fn record_methods(lines, name) {
  let choice = pick(6)
  if (choice == 0) {
    lines.push("print(join(" + name + ", \"|\"))")
  } else if (choice == 1) {
    lines.push("print(" + name + ".join(\"-\"))")
    lines.push("print(" + name + ".join())")
  } else if (choice == 2) {
    lines.push("print(" + name + ".sort(fn(x, y) { return x.a - y.a }))")
    lines.push("print(" + name + ")")
  } else if (choice == 3) {
    lines.push("print(" + name + ".contains(" + name + "[0]))")
    lines.push("print(" + name + ".index_of(" + name + "[0]))")
    lines.push("print(contains(" + name + ", " + name + "[0]))")
    lines.push("print(index_of(" + name + ", " + name + "[0]))")
  } else if (choice == 4) {
    lines.push("print(" + name + ".pop())")
    lines.push("print(" + name + ")")
  } else {
    lines.push("print(map(" + name + ", fn(x) { return x.a }))")
    lines.push("print(filter(" + name + ", fn(x) { return x.a > " + num() + " }))")
    lines.push("each(" + name + ", fn(x) { print(x.a) })")
  }
}fn null_program() {
  let lines = []
  lines.push("print(null)")
  lines.push("print(str(null))")
  lines.push("print(json(null))")
  lines.push("print(type(null))")
  lines.push("let z = null")
  lines.push("print(z == null)")
  lines.push("print(z == 0)")
  lines.push("print(z == false)")
  lines.push("print(z == 0.0)")
  lines.push("print(z == \"\")")
  lines.push("print(z != null)")
  lines.push("print(!z)")
  lines.push("if (z) { print(\"t\") } else { print(\"f\") }")
  lines.push("print(z ? \"t\" : \"f\")")
  lines.push("print(\"v=$" + "{z}\")")
  lines.push("print(z + 1)")
  lines.push("print(1 + z)")
  lines.push("print(z + z)")
  lines.push("print(z - 1)")
  lines.push("print(z * 3)")
  lines.push("print(z / 2)")
  lines.push("print(z % 2)")
  lines.push("print(-z)")
  lines.push("print(z < 1)")
  lines.push("print(z <= 0)")
  lines.push("print(z >= 0)")
  lines.push("print(z > -1)")
  lines.push("print(1 > z)")
  lines.push("print(\"a\" + z)")
  lines.push("print(int(z))")
  lines.push("print(float(z))")
  lines.push("print(z || true)")
  lines.push("print(z && true)")
  return lines
}
fn gen() {
  let lines = []
  lines.push("print(\"method-differential\")")
  if (pick(2) == 0) {
    lines.push("let b0 = " + bools())
    bool_methods(lines, "b0")
  }
  if (pick(2) == 0) {
    lines.push("let i0 = " + ints())
    int_methods(lines, "i0")
  }
  if (pick(2) == 0) {
    lines.push("let s0 = " + strings())
    str_methods(lines, "s0")
  }
  if (pick(2) == 0) {
    lines.push("let f0 = " + floats())
    float_methods(lines, "f0")
  }
  if (pick(2) == 0) {
    lines.push("let r0 = " + records())
    record_methods(lines, "r0")
  }
  if (pick(3) == 0) {
    lines.push("let rows0 = " + int_rows())
    lines.push("print(join(rows0, \";\"))")
    lines.push("print(rows0.join(\"+\"))")
    lines.push("print(rows0.contains(rows0[0]))")
    lines.push("print(rows0.index_of(rows0[0]))")
  }
  if (pick(3) == 0) {
    lines.push("let trs0 = " + text_rows())
    lines.push("print(join(trs0, \"|\"))")
    lines.push("print(trs0.contains(trs0[0]))")
    lines.push("print(contains(trs0, trs0[0]))")
  }
  if (pick(2) == 0) {
    let extra = null_program()
    for (let i = 0; i < len(extra); i += 1) {
      lines.push(extra[i])
    }
  }
  let source = ""
  for (let i = 0; i < len(lines); i += 1) {
    source = source + lines[i] + "\n"
  }
  return source
}
let failures = 0
for (let c = 0; c < cases; c += 1) {
  let source = gen()
  let script = dir + "/case-" + str(c) + ".bxs"
  let module = dir + "/case-" + str(c) + ".wasm"
  write(script, source)
  let vm = exec([bin, "run", script])
  let built = exec([bin, "build", "--wasm", script, "-o", module])
  if (built.code != 0) {
    failures += 1
    eprint("case " + str(c) + ": wasm build failed: " + built.err + "\n--- source ---\n" + source)
    continue
  }
  let wasm = exec([bin, "run", module])
  if (vm.code != wasm.code || vm.out != wasm.out) {
    failures += 1
    eprint(
      "case " + str(c) + ": VM and wasm disagree\n" +
        "vm:   " + json(vm.out) + "\n" +
        "wasm: " + json(wasm.out) + "\n--- source ---\n" + source
    )
  }
}
if (failures > 0) {
  eprint(str(failures) + " of " + str(cases) + " cases failed\n")
  exit(1)
}
print("OK " + str(cases) + " cases\n")