// Differential tester: the same generated program is run by bx's VM and by the
// wasm backend, and the two outputs must match byte-for-byte.
//
//   bx run tools/wasm-diff.bxs path/to/bx [cases]
//
// Only the shared int subset is generated (locals, arithmetic, comparisons,
// if/else, while, print) so a mismatch always means an implementation bug in
// one of the two backends rather than an unsupported feature.
if (len(argv) < 1) {
  eprint("usage: bx run tools/wasm-diff.bxs <bx-binary-or-com> [cases]\n")
  exit(2)
}
let bin = argv[0]
let cases = 24
if (len(argv) > 1) {
  cases = int(argv[1])
}
let tmp = env("TEMP")
if (tmp == "" || tmp == null) {
  tmp = env("TMPDIR")
}
if (tmp == "" || tmp == null) {
  tmp = cwd()
}
let dir = tmp + "/bx-wasm-diff-" + str(now())
mkdir(dir)

let seed = 987654321
fn next() {
  seed = (seed * 48271) % 2147483647
  if (seed == 0) {
    seed = 12345
  }
  return seed
}
fn pick(n) {
  return next() % n
}
fn atom(vars) {
  if (len(vars) > 0 && pick(2) == 0) {
    return vars[pick(len(vars))]
  }
  if (pick(4) == 0) {
    return str(1 + pick(20)) + "." + str(pick(9))
  }
  return str(1 + pick(30))
}
fn small_atom() {
  if (pick(4) == 0) {
    return str(1 + pick(9)) + "." + str(pick(9))
  }
  return str(1 + pick(9))
}
fn expr(vars) {
  let text = atom(vars)
  let ops = 1 + pick(2)
  for (let i = 0; i < ops; i += 1) {
    let kind = pick(5)
    if (kind == 0) {
      text = text + " + " + atom(vars)
    }
    if (kind == 1) {
      text = text + " - " + atom(vars)
    }
    if (kind == 2) {
      text = text + " * " + small_atom()
    }
    if (kind == 3) {
      text = text + " / " + str(1 + pick(8))
    }
    if (kind == 4) {
      text = text + " % " + str(1 + pick(8))
    }
  }
  return text
}
fn gen() {
  let vars = []
  let lines = []
  lines.push("fn helper0(a, b) {")
  lines.push("  return a * 2 + b - 1")
  lines.push("}")
  lines.push("fn fact(n) {")
  lines.push("  if (n < 2) { return 1 }")
  lines.push("  return n * fact(n - 1)")
  lines.push("}")
  lines.push('let cmp_a = "abc" + "d"')
  lines.push('let cmp_b = "ab" + "c"')
  if (pick(2) == 0) {
    lines.push('if (cmp_a < cmp_b) { print(1) } else { print(2) }')
  } else {
    lines.push('if (cmp_a == cmp_b) { print(1) } else { print(2) }')
  }
  lines.push("print(str(" + str(1 + pick(99)) + "))")
  lines.push("print(int(\"" + str(1 + pick(99)) + "\"))")
  lines.push("let conv = \"n\" + str(" + str(1 + pick(9)) + ")")
  lines.push("print(conv.len())")
  lines.push('print("".contains(""))')
  lines.push('print("abc".starts_with(""))')
  lines.push("print(true == false)")
  lines.push("print(false < true)")
  lines.push("let idx_arr = [4, 5, 6]")
  lines.push("print(idx_arr[-1])")
  lines.push("print(idx_arr[1.9])")
  lines.push('print("hello"[1])')
  lines.push('print("hello"[-1])')
  lines.push("let none = []")
  lines.push("print(len(none))")
  lines.push("for nv in none { print(nv) }")
  lines.push("print(\"abc\".contains(\"b\"))")
  lines.push("print(\"abc\".starts_with(\"ab\"))")
  lines.push("print(\"abc\".ends_with(\"bc\"))")
  lines.push("let rec = {p: " + str(1 + pick(9)) + ", q: " + str(1 + pick(9)) + "}")
  lines.push("let rec_sum = 0")
  lines.push("for rk, rv in rec { rec_sum = rec_sum + rv }")
  lines.push("print(rec_sum)")
  lines.push("print(exists(\".\"))")
  lines.push("print(!exists(\".\"))")
  lines.push("let edge_acc = 0")
  lines.push("for ev in [1, 2, 3] { let ej = 0\n  while (ej < 3) { ej = ej + 1\n    if (ej == 2) { continue }\n    if (ej == 3) { break }\n    edge_acc = edge_acc + ev * ej } }")
  lines.push("print(edge_acc)")
  lines.push("let rec2 = {m: 1, n: 2, o: 3}")
  lines.push('for rk, rv in rec2 { if (rv == 2) { continue }\n  if (rv == 3) { break }\n  print(rk + ":" + str(rv)) }')
  lines.push("for xa in [1, 2] { for xb in [3, 4] { if (xb == 4) { break }\n  print(xa + xb) } }")
  lines.push("let cont_arr = [1, 2, 3, 4]")
  lines.push("let cont_sum = 0")
  lines.push("for cv in cont_arr { if (cv == 2) { continue } cont_sum = cont_sum + cv }")
  lines.push("print(cont_sum)")
  lines.push("let cont_for = 0")
  lines.push("for (let ci = 0; ci < 5; ci += 1) { if (ci % 2 == 0) { continue } cont_for = cont_for + ci }")
  lines.push("print(cont_for)")
  lines.push('let cont_rec = {x: 1, y: 2, z: 3}')
  lines.push("let cont_rec_acc = 0")
  lines.push('for ck, cv2 in cont_rec { if (ck == "y") { continue } cont_rec_acc = cont_rec_acc + cv2 }')
  lines.push("print(cont_rec_acc)")
  lines.push("let bool_a = " + str(1 + pick(9)) + " < " + str(1 + pick(9)))
  lines.push("print(bool_a)")
  lines.push("let bool_b = bool_a && (" + str(1 + pick(9)) + " == " + str(1 + pick(9)) + ")")
  lines.push("print(bool_b)")
  lines.push("print(!bool_b)")
  lines.push("print(bool_a ? " + str(1 + pick(9)) + " : " + str(1 + pick(9)) + ")")
  lines.push("let it = [1, 2, 3]")
  lines.push("let its = 0")
  lines.push("for iv in it { its = its + iv }")
  lines.push("print(its)")
  lines.push("let grow = [1, 2]")
  lines.push("grow.push(" + str(1 + pick(9)) + ")")
  lines.push("print(len(grow))")
  if (pick(2) == 0) {
    lines.push("print(grow[2])")
  }
  lines.push("fn rich() {")
  lines.push("  let a = [4, 5]")
  lines.push("  let s = \"d\"")
  lines.push("  print(a[1])")
  lines.push("  print(s + \"iff\")")
  lines.push("}")
  lines.push("rich()")
  lines.push("print(helper0(" + str(1 + pick(9)) + ", " + str(1 + pick(9)) + "))")
  lines.push("print(fact(" + str(1 + pick(5)) + "))")
  if (pick(2) == 0) {
    lines.push("print(helper0(2, 3) + 0.5)")
  }
  if (pick(3) == 0) {
    lines.push("print(\"differential-ok\")")
  }
  let vars_count = 2 + pick(3)
  for (let i = 0; i < vars_count; i += 1) {
    let name = "v" + str(i)
    lines.push("let " + name + " = " + expr(vars))
    vars.push(name)
  }
  let prints = 2 + pick(3)
  for (let i = 0; i < prints; i += 1) {
    lines.push("print(" + expr(vars) + ")")
  }
  let rounds = 1 + pick(4)
  lines.push("let w = 0")
  lines.push("while (w < " + str(rounds) + ") {")
  lines.push("  w += 1")
  if (pick(2) == 0) {
    lines.push("  print(helper0(w, " + str(1 + pick(5)) + "))")
  }
  lines.push("  print(w + " + atom(vars) + ")")
  lines.push("}")
  if (pick(2) == 0) {
    lines.push("if (" + atom(vars) + " < " + atom(vars) + ") {")
    lines.push("  print(" + expr(vars) + ")")
    lines.push("} else {")
    lines.push("  print(" + expr(vars) + ")")
    lines.push("}")
  }
  let source = ""
  for (let i = 0; i < len(lines); i += 1) {
    source = source + lines[i] + "\n"
  }
  return source
}

let failures = 0
for (let c = 0; c < cases; c += 1) {
  let source = gen()
  let script = dir + "/case-" + str(c) + ".bxs"
  let module = dir + "/case-" + str(c) + ".wasm"
  write(script, source)
  let vm = exec([bin, "run", script])
  let built = exec([bin, "build", "--wasm", script, "-o", module])
  if (built.code != 0) {
    failures += 1
    eprint("case " + str(c) + ": wasm build failed: " + built.err + "\n--- source ---\n" + source)
    continue
  }
  let wasm = exec([bin, "run", module])
  if (vm.code != wasm.code || vm.out != wasm.out) {
    failures += 1
    eprint(
      "case " + str(c) + ": VM and wasm disagree\n" +
      "  vm code/out:   " + str(vm.code) + " " + json(vm.out) + "\n" +
      "  wasm code/out: " + str(wasm.code) + " " + json(wasm.out) + "\n" +
      "--- source ---\n" + source
    )
  }
}
if (failures == 0) {
  print("PASS " + str(cases) + " differential cases\n")
  exit(0)
}
print("FAIL " + str(failures) + " of " + str(cases) + " differential cases\n")
exit(1)
